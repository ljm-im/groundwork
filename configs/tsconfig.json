{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "erasableSyntaxOnly": true,
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "svelte",
            "vite/client",
            "node"
        ]
    },
    "include": [
        "../src/**/*",
        "../test/**/*.ts",
        "./*.ts"
    ]
}