{
    "name": "groundwork",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "AGPL-3.0-only",
    "packageManager": "pnpm@12.5.1",
    "scripts": {
        "dev": "vite --config configs/vite.config.ts",
        "test": "node --test --test-concurrency=1 --test-reporter=./configs/test-reporter.ts test/*.test.ts",
        "test:browser": "node --test scripts/browser/editor.ts",
        "export": "node scripts/export.ts",
        "perf": "node configs/perf.ts",
        "check": "svelte-check --tsconfig configs/tsconfig.json --config configs/svelte.config.js && eslint --max-warnings 0 --config configs/eslint.config.js .",
        "build": "vite build --config configs/vite.config.ts"
    },
    "devDependencies": {
        "@eslint/css": "2.0.0",
        "@eslint/json": "2.1.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@types/node": "22.20.2",
        "eslint": "10.10.0",
        "eslint-plugin-svelte": "3.23.0",
        "eslint-plugin-yml": "3.8.1",
        "svelte": "5.57.0",
        "svelte-check": "4.7.6",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vite": "8.3.5"
    }
}